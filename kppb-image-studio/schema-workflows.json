    ],
    "output_matchtypes": null,
    "name": "QwenImage21Cache",
    "display_name": "Qwen Image 2.1 Cache",
    "description": "Allows setting the KV cache device and quantization, by default the model uses the auto -option. Quantization potentially speeds up edit workflows when memory starved ",
    "python_module": "comfy_extras.nodes_qwen",
